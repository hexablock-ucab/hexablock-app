{
  "name": "hexablock-app-tooling",
  "private": true,
  "description": "Git tooling only (commitlint and lefthook). The app itself is a Dart workspace.",
  "scripts": {
    "prepare": "lefthook install",
    "check:architecture": "node tool/check-architecture.mjs",
    "check:test-names": "node tool/check-test-names.mjs",
    "check:coverage": "node tool/check-coverage.mjs",
    "check:class-model": "node tool/class-model/generate.mjs --check",
    "generate:class-model": "node tool/class-model/generate.mjs",
    "test:tool": "node --test \"tool/**/*.test.mjs\"",
    "sync:levels": "node tool/sync-levels.mjs",
    "check:levels-sync": "node tool/sync-levels.mjs --check"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "lefthook": "^2.2.2"
  },
  "engines": {
    "node": ">=22"
  }
}
